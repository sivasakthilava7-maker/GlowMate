# GlowMate Environment Configuration Template
# DO NOT COMMIT SENSITIVE API KEYS TO SOURCE CONTROL.

# Google AI Studio Gemini API Key
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini Model Selection (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
